# Copy this file to .env and fill in the values below.
CLIENT_ID=replace-with-your-entra-application-client-id

# Use "common" for a personal Outlook.com/Hotmail account or a multi-tenant app.
# For a work/school account, your tenant ID is the safer choice.
TENANT_ID=common

# Use Inbox, or the name of the dedicated Outlook folder you create (for example: Automation).
OUTLOOK_FOLDER=Inbox

# Absolute path on this computer. Create the folder first.
DOWNLOAD_FOLDER=C:\\Users\\aravinalochanan\\Downloads\\OutlookAttachments

# Optional matching rules. Leave blank to accept all messages/attachments.
# Sender should be an exact email address; subject is matched as a case-insensitive substring.
SENDER_EMAIL=
SUBJECT_CONTAINS=
# Comma-separated, including the dot. Example: .pdf,.xlsx,.docx
ALLOWED_EXTENSIONS=.pdf,.xlsx,.xls,.docx,.doc

# On its first run, only inspect messages received within this many days.
LOOKBACK_DAYS=7
